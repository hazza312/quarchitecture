                      5  equ zPageVariables, 0
                      6  equ zvCurrByte, 0
                      7  equ zvCurrBit, 1
                      8  equ zvQrDataStart, 2
                      9  equ zvQrDataSize, 3
                     10   # lookup tables (populated at runtime)
                     11  equ logLut, 44
                     12  equ expLut, 300
                     13   # buffers
                     14  equ polyBase, 556
                     15  equ byteBufferStart, 1000
                     16  
                     17   # initialise variables
00000 PAM            18  ldi byteBufferStart
