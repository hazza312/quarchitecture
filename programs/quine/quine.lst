                     27   # FILE: 101_read11BitNumber.asm #############################################
                     28   # TODO this could be simplified the two fns together,
                     29   # but kept separate for now to make debugging easier
                     30  
                     31  read11BitNumber: # ( addr -- n )
                     32   # read next 11-bit value (P27)
00010 MK0            33   call readPmTwoChars
00013 Z              34   swap
00014 P01            35   ldi 45
00017 5              36   mul 
00018 3              37   add
00019 I              38   ret
                     39  
                     40  readPmTwoChars: #( addr -- c1 c2 )
                     41   # lpm command reads a 2char signed number
                     42   # this reads and interpets as unsigned
                     43   # pushing the two chars (hi lo) on the stack 
00020 V              44   ldp
00021 W              45   dup
00022 GM$0           46   m ? call _correctNum
00026 W              47   dup
00027 P01            48   ldi 45
00030 7              49   mod
00031 Z              50   swap
00032 P01            51   ldi 45
00035 6              52   div
00036 I              53   ret
                     54  
                     55  _correctNum:
00037 Q::0           56    ldi 2024 # 45 * 45 - 1
00041 3              57    add
00042 I              58    ret
                     59  
                     60   # FILE: 102_appendBitToBitString.asm ########################################
                     61   # DEFINES:
                     62   #   appendBitToBitString( 0/1 -- )
                     63   # USES:
                     64   #   000 zvCurrByte, state initialised to beginning of output buffer
                     65   #   000 zvCurrBit, state initialised to 0, next bit to be written in current byte
                     66  
                     67  appendBitToBitString: # ( 0/1 -- )
00043 T1             68   ldz zvCurrBit         # load the current bit
00045 O8             69   ldi 8                 # check if we have filled 8 bits
00047 4              70   sub
00048 EMN1           71   z? call _advanceByte  # if so, advance to next byte
00052 T0             72   ldz zvCurrByte        # load address of current byte
                     73                         # load the value, shift left 1 bit
00054 R              74   ld
00055 O1             75   ldi 1
00057 9              76   shl
                     77                         # append the current bit and store
00058 C              78   or
00059 T0             79   ldz zvCurrByte
00061 S              80   st
                     81                         # increment the bit count and store
00062 T1             82   ldz zvCurrBit
00064 0              83   inc
00065 U1             84   stz zvCurrBit
00067 I              85   ret
                     86  
                     87  _advanceByte:
00068 O0             88   ldi 0                 # reset zvCurrBit to 0
00070 U1             89   stz zvCurrBit
00072 T0             90   ldz zvCurrByte        # increment the byte ptr and store back
00074 0              91   inc
00075 U0             92   stz zvCurrByte
00077 I              93   ret
                     94  
                     95   # FILE: 103_appendBitsToBitString.asm #######################################
                     96  appendBitsToBitString: # ( val nBits -- )
                     97   # appends for a single value the bits, left padded
                     98   # place nBits on rstack and iteratively call appendBitToBitString masking
                     99   # for the correct bit
                    100  
00078 1             101   dec
00079 +             102   tor
                    103  l103:
00080 W             104   dup
00081 %             105   rtop
00082 A             106   shr
00083 O1            107   ldi 1
00085 D             108   and
00086 M/0           109   call appendBitToBitString
00089 NY            110   loop l103
00091 X             111   drop
00092 I             112   ret
                    113  
                    114   # FILE: 103_writeQrHeaders.asm ##############################################
                    115   # USES:
                    116   #   000 zvQrDataSize
                    117   #   000 zvQrDataStart
                    118   #   103 appendBitsToBitString
                    119  
                    120  writeQrHeaders: # ( -- )
                    121   # first write the mode indicator
00093 O2            122   ldi 2 # mode 0b0010 is alphanumeric mode (P 23)
00095 O4            123   ldi 4
00097 MX1           124   call appendBitsToBitString
                    125  
                    126   # then add the character count
                    127   # TODO: number of bits is determined by QR "verison"
                    128   #  (https://www.qrcode.com/en/about/version.html)
                    129   # V1-9 => 9 bits
                    130   # V10-26 => 11 bits
                    131   # V27-40 => 13 bits
                    132  
00100 T3            133   ldz zvQrDataSize
00102 O9            134   ldi 9
00104 MX1           135   call appendBitsToBitString
                    136  
                    137   # then write qr code stream
                    138   # for all the pairs of alphanumeric characters, write them as 11bit values
                    139   # loop dataSize/2 times
00107 T3            140   ldz zvQrDataSize
00109 O2            141   ldi 2
00111 6             142   div
00112 1             143   dec
00113 +             144   tor
                    145   # start at beginning of data
00114 T2            146   ldz zvQrDataStart
                    147  l104:
00116 W             148   dup
00117 MA0           149   call read11BitNumber
00120 OB            150   ldi 11
00122 MX1           151   call appendBitsToBitString
                    152   # move pointer to next pair
00125 0             153   inc
00126 0             154   inc
00127 NW            155   loop l104
                    156  
                    157   # ok, if the data size is odd, we need to pad the last one with 6 bits
00129 T3            158   ldz zvQrDataSize
00131 O1            159   ldi 1
00133 D             160   and
00134 EKD3          161   z? jmp d103
00138 MK0           162   call readPmTwoChars
00141 X             163   drop
00142 O6            164   ldi 6
00144 MX1           165   call appendBitsToBitString
00147 I             166   ret
                    167  
                    168  d103:
00148 X             169   drop
00149 I             170   ret
                    171  
                    172   # FILE: 201_qrHeaderBitsInCharacterCount.asm ################################
                    173  
                    174  qrHeaderBitsInCharacterCount: # ( -- n)
                    175   # assuming alphanumeric mode, see P23
                    176  
                    177  
                    178   # FILE: 300_expLogLut.asm ###################################################
                    179   # generate lookup tables as defined in https://dev.to/maxart2501/let-s-develop-a-qr-code-generator-part-iii-error-correction-1kbm
                    180  
                    181  expLogLut:
00150 PT5           182   ldi 254
00153 +             183   tor
00154 O1            184   ldi 1 # initial value
                    185  l300:
00156 MF4           186   call nextValue
00159 W             187   dup
                    188   # get exponent from loop index
00160 %             189   rtop
00161 M54           190   call loopIdxToExponent
00164 M 3           191   call storeValueExponent
00167 NW            192   loop l300
00169 X             193   drop
00170 I             194   ret
                    195  
                    196  storeValueExponent: # (value exponent)
00171 Y             197   over
00172 Y             198   over           # v e v e
00173 Z             199   swap
00174 P:0           200   ldi logLut
00177 3             201   add
00178 S             202   st             # v e
00179 PU6           203   ldi expLut
00182 3             204   add
00183 S             205   st
00184 I             206   ret
                    207  
                    208  
                    209  loopIdxToExponent: # ( n -- n)
00185 PU5           210   ldi 255
00188 Z             211   swap
00189 4             212   sub
00190 PU5           213   ldi 255
00193 7             214   mod
00194 I             215   ret
                    216  
                    217  nextValue: # ( n -- n )
00195 O1            218   ldi 1
00197 9             219   shl
                    220   # if > 255, xor with 285
00198 W             221   dup
00199 PU5           222   ldi 255
00202 4             223   sub
00203 GI            224   m? ret
00205 PF6           225   ldi 285
00208 B             226   xor
00209 I             227   ret
                    228   # FILE: 301_gfMulDiv2.asm ####################################################
                    229   # this version doesn't use lookup tables
                    230  
                    231  gfMul2: # ( a b -- n )
00210 O0            232   ldi 0
00212 +             233   tor
                    234  inner:
00213 Y             235   over # a b a
00214 Y             236   over # a b a b
00215 5             237   mul  # a b a*b
00216 EKV5          238   z? jmp done
00220 W             239   dup # a b b
00221 O1            240   ldi 1 # a b b 1
00223 D             241   and # a b b&1
00224 EK75          242   z? jmp ctd1
00228 Y             243   over # a b a
00229 *             244   tos # a b a p
00230 B             245   xor # a b a^p
00231 +             246   tor # a b
                    247  ctd1:
00232 Z             248   swap # b a
00233 O1            249   ldi 1 # b a 1
00235 9             250   shl # b a<<1
00236 W             251   dup # b a a
00237 PV5           252   ldi 256 # b a a
00240 D             253   and # b a a&256
00241 EKO5          254   z? jmp ctd2 # b a
00245 PF6           255   ldi 285  # b a 285
00248 B             256   xor # b a^285
                    257  ctd2:
00249 Z             258   swap # a b
00250 O1            259   ldi 1 # a b
00252 A             260   shr # a b>1
00253 KX4           261   jmp inner
                    262  done:
00256 X             263   drop
00257 X             264   drop
00258 *             265   tos
00259 I             266   ret
                    267  
                    268   # FILE: 303_gfPolyMul.asm ###################################################
                    269  
                    270  
                    271  gfPolyMul: # ( paddr psize n -- )
                    272   # put n on the side for later
                    273   # note that psize should be total "capacity" of polynomial (not current order)
00260 +             274   tor
00261 Y             275   over
00262 Y             276   over
                    277   # ( paddr pszie paddr psize )
                    278   # multiplying by 1x, shift each element one spot in the coefficient array
00263 1             279   dec
00264 +             280   tor
                    281  l303:
00265 W             282   dup
00266 %             283   rtop
00267 3             284   add
00268 MJ6           285   call gfShift
00271 N$            286   loop l303
00273 X             287   drop
                    288  
00274 *             289   tos
00275 Z             290   swap
                    291  
                    292   # ( paddr n psize )
                    293   # now that we have shifted one spot, need to do A[i] += A[i+1] * n
00276 +             294   tor
00277 Z             295   swap
                    296  l303b:
                    297   # ( n paddr )
00278 Y             298   over
00279 Y             299   over
00280 MP6           300   call gfMulElement
00283 0             301   inc
00284 N$            302   loop l303b
                    303  
00286 X             304   drop
00287 X             305   drop
00288 I             306   ret
                    307  
                    308  
                    309  gfShift: # ( paddr )
00289 W             310   dup
00290 1             311   dec
00291 R             312   ld
                    313   # ( paddr p[n-1] )
00292 Z             314   swap
00293 S             315   st
00294 I             316   ret
                    317  
                    318  gfMulElement: # ( n paddr -- )
00295 W             319   dup
00296 0             320   inc
00297 R             321   ld
                    322   # ( n paddr A[i+1] )
00298 $             323   rot
                    324   # ( paddr A[i+1] n )
00299 M00           325   call gfMul
                    326   # ( paddr A[i+1]*n )
00302 Z             327   swap
                    328   # ( A[i+1]*n paddr )
00303 W             329   dup
00304 R             330   ld
                    331   # ( A[i+1]*n paddr A[i])
00305 $             332   rot
                    333   # ( paddr A[i] A[i+1]*n )
00306 B             334   xor
                    335   # ( paddr A[i]+A[i+1]*n )
00307 Z             336   swap
                    337   # ( A[i]+A[i+1]*n paddr )
00308 S             338   st
00309 I             339   ret
                    340   # FILE: 304_generatorPoly.asm ###############################################
                    341  
                    342  generatorPoly: # ( degree )
                    343   # set initial polynomial 1x^0
00310 O1            344   ldi 1
00312 PGC           345   ldi polyBase
00315 S             346   st
                    347  
00316 1             348   dec
00317 +             349   tor
                    350  l304:
                    351   # paddr
00318 PGC           352   ldi polyBase
                    353  
                    354   # psize, TODO check what max size could be
00321 PW0           355   ldi 32
                    356  
                    357   # EXP[index]
00324 %             358   rtop
00325 PU6           359   ldi expLut
00328 3             360   add
00329 R             361   ld
                    362  
00330 MZ5           363   call gfPolyMul
00333 NS            364   loop l304
00335 I             365   ret
