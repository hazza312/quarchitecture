                      5  equ zPageVariables, 0
                      6  equ zvCurrByte, 0
                      7  equ zvCurrBit, 1
                      8  equ zvQrDataStart, 2
                      9  equ zvQrDataSize, 3
                     10   # lookup tables (populated at runtime)
                     11  equ logLut, 44
                     12  equ expLut, 300
