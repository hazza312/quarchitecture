00336 1             371   dec
00337 +             372   tor
00338 %             373   rtop
00339 3             374   add
                    375  
                    376  l306:           # A B
00340 Y             377   over           # A B A
00341 R             378   ld             # A B Ad
00342 Y             379   over           # A B Ad B
00343 S             380   st             # A B
00344 1             381   dec            # A B-1
00345 Z             382   swap           # B-1 A
00346 0             383   inc            # B-1 A+1
00347 Z             384   swap           # A+1 B-1
00348 NZ            385   loop l306
00350 I             386   ret
