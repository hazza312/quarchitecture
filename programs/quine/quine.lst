                    388   # FILE: 307_findDegree.asm ###############################################
                    389   # finds the degree of a polynomial
                    390  
                    391  findDegree: # ( poly size -- d )
00351 1             392   dec                        # base size-1
00352 +             393   tor
00353 W             394   dup                        # base base
00354 %             395   rtop
00355 3             396   add                        # base ptr
                    397  l307:                       # base ptr
00356 W             398   dup                        # base ptr ptr
00357 R             399   ld                         # base ptr val
00358 FK88          400   nz? jmp l307earlyreturn    # base ptr
00362 1             401   dec                        # base ptr-1
00363 N             402   loop l307
00365 4             403   sub
00366 1             404   dec
                    405   # 0
                    406   # TODO maybe would be useful to return -1 instead
00367 I             407   ret
                    408  
                    409  l307earlyreturn:
00368 *             410   tos
00369 X             411   drop
00370 4             412   sub
00371 2             413   neg
                    414   # n
00372 I             415   ret
                    416  # FILE: 308_polyDiv.asm ###############################################
                    417  # does polynomial division
                    418  # translated from this C prototype (probably has bugs)
                    419  
                    420  # int p[] = {4, 5, 8, 28}; // 1 + 2x + 3x^2
                    421  # int d[] = {2, 7, 2}; // 1 + x
                    422  
                    423  # int pHighestPower = sizeof(p)/sizeof(int) - 1;
                    424  # int dLeadingPower = sizeof(d)/sizeof(int) - 1;
                    425  
                    426  # for (int pLeadingPower = pHighestPower; pLeadingPower >= dLeadingPower; pLeadingPower--) {
                    427  #    int q = p[pLeadingPower] / d[dLeadingPower];
                    428  
                    429  #     for (int pi = pLeadingPower, di = dLeadingPower; di >= 0; di--, pi--) {
                    430  #         p[pi] = p[pi] - q * d[di];
                    431  #     }
                    432  # }
                    433  
                    434  # return 0;
                    435  
                    436  # some working variables
                    437  equ zvDividend, 22
                    438  equ zvDivisor, 23
                    439  equ zvDivisorOrder, 24
                    440  
                    441  polyDiv: # ( p pSize d2 dSize )
                    442   # let's do away with size and find the leading powers of each
00373 Y             443   over
00374 Z             444   swap                       # p pSize d d dSize
00375 M 7           445   call findDegree            # p pSize d dOrder
                    446                              # put divisor away for now
00378 UO            447   stz zvDivisorOrder         # p pSize d
00380 UN            448   stz zvDivisor              # p pSize
                    449  
00382 Y             450   over                       # p pSize p
00383 Z             451   swap                       # p p pSize
00384 M 7           452   call findDegree            # p pDegree
00387 +             453   tor                        # p     R: pDegree
00388 UM            454   stz zvDividend             # --    R: pDegree
                    455  
                    456  l308outer:
00390 %             457   rtop                       # plp
00391 M39           458   call l308outerbody         # --
00394 %             459   rtop                       # plp
00395 TO            460   ldz zvDivisorOrder         # plp dorder
00397 4             461   sub                        # plp-dorder
00398 EK09          462   z? jmp l308earlydone       # --
00402 NV            463   loop l308outer             # --
00404 I             464   ret
                    465  
                    466  l308earlydone:
00405 *             467   tos
00406 X             468   drop
00407 I             469   ret
                    470  
                    471  l308outerbody: # ( pLeadingPower -- )
                    472   # q = p[pLeadingPower] / d[dLeadingPower]
00408 W             473   dup                        # plp plp
00409 TM            474   ldz zvDividend             # plp plp p
00411 3             475   add                        # plp &p[plp]
00412 R             476   ld                         # plp p[plp]
                    477  
00413 TN            478   ldz zvDivisor              # plp p[plp] d
00415 TO            479   ldz zvDivisorOrder         # plp p[plp] d dlp
00417 3             480   add                        # plp p[plp] &d[dlp]
00418 R             481   ld                         # plp p[plp] d[dlp]
00419 6             482   div                        # plp q
                    483  
00420 TO            484   ldz zvDivisorOrder         # plp q dlp
00422 +             485   tor                        # pi q R: di
                    486  l308inner:
                    487   # iterate decrementing pi and di,
                    488   # do p[pi] -= q*d[di], p[pi-1] -= q*d[di-1], ...
00423 Y             489   over                       # pi q pi
00424 Y             490   over                       # pi q pi q
00425 %             491   rtop                       # pi q pi q di
00426 MW9           492   call l308innerbody         # pi q
00429 Z             493   swap                       # q pi
00430 1             494   dec                        # q pi-1
00431 Z             495   swap                       # pi-1 q
00432 NY            496   loop l308inner
00434 X             497   drop                       # pi-1
00435 X             498   drop                       # --
00436 I             499   ret
                    500  
                    501  
                    502  l308innerbody: # ( pi q di -- )
                    503   # performs a single p[pi] = p[pi] - q * d[di];
00437 TN            504   ldz zvDivisor              # pi q di d
00439 3             505   add                        # pi q di &d[di]
00440 R             506   ld                         # pi q d[di]
00441 5             507   mul                        # pi q*d[di]
00442 Z             508   swap                       # q*d[di] pi
00443 TM            509   ldz zvDividend             # q*d[di] pi p
00445 3             510   add                        # q*d[di] &pi[p]
00446 W             511   dup                        # q*d[di] &pi[p] &pi[p]
00447 R             512   ld                         # q*d[di] &pi[p] pi[p]
00448 $             513   rot                        # &pi[p] pi[p] q*d[di]
00449 4             514   sub                        # &pi[p] pi[p]-q*d[di]
00450 Z             515   swap                       # pi[p]-q*d[di] &pi[p]
00451 S             516   st                         # --
00452 I             517   ret
                    518  
